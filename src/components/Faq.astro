---
import { faq } from '../data/faq';
---
<section class="section rule" id="faq">
  <div class="wrap faq-layout">
    <div><span class="eyebrow">一点说明 / FAQ</span><h2>开始之前，<br />你可能想知道。</h2>
      <p class="muted">把需要配置的部分说清楚，<br />也把能力的边界说清楚。</p>
      <a class="text-link" href="/help/">阅读使用帮助 ↗</a>
    </div>
    <div class="faq">{faq.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
  </div>
</section>
