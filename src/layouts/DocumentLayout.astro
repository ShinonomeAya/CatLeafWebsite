---
import type { MarkdownLayoutProps } from 'astro';
import SiteLayout from './SiteLayout.astro';
type Props = MarkdownLayoutProps<{ title: string; description: string }>;
const { frontmatter } = Astro.props;
---
<SiteLayout title={`${frontmatter.title} · CatLeaf（猫页）`} description={frontmatter.description} document>
  <a class="text-link" href="/">← 返回首页</a>
  <span class="eyebrow" style="margin-top:35px">CATLEAF / 猫页</span>
  <h1>{frontmatter.title}</h1>
  <slot />
</SiteLayout>
