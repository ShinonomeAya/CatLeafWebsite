{
  "name": "catleaf-website-design",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build && node tools/build-download-worker.mjs",
    "preview": "astro preview",
    "check:release": "node --experimental-strip-types tools/check-release.mjs",
    "test:release": "node --experimental-strip-types --test tools/tests/release-sync.test.mjs",
    "sync:release": "node --experimental-strip-types tools/release-sync.mjs",
    "verify:download": "node --experimental-strip-types tools/verify-download.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.3.8",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  }
}